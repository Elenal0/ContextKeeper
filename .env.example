# ContextKeeper — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default) — file is created automatically
DATABASE_URL=sqlite:///./contextkeeper.db
# Fly.io (persistent volume):
# DATABASE_URL=sqlite:////data/contextkeeper.db
# PostgreSQL (scale-out):
# DATABASE_URL=postgresql://user:password@localhost:5432/contextkeeper

# ── Paths — point at your volume in production ────────────────────────────────
LOG_DIR=logs
UPLOAD_DIR=uploads
# Fly.io values:
# LOG_DIR=/data/logs
# UPLOAD_DIR=/data/uploads

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── AI Provider ──────────────────────────────────────────────────────────────
# Options: mock | gemini | anthropic | openai
# "mock" works fully offline — good for development/demo
AI_PROVIDER=mock

# Provider API keys — set the one matching AI_PROVIDER
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI behaviour (optional overrides)
# AI_MODEL=                # overrides provider default model
# AI_TEMPERATURE=0.2
# AI_TIMEOUT_SECONDS=60
# AI_MAX_RETRIES=3

# Simulate AI failures (mock provider only)
# MOCK_AI_FAIL=            # leave empty for normal; set to: timeout | rate_limit | upstream | json_error

# ── Admin ────────────────────────────────────────────────────────────────────
# REQUIRED in production — set via: fly secrets set ADMIN_TOKEN=<random>
ADMIN_TOKEN=change-this-admin-token
