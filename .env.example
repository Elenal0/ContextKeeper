# ContextKeeper — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default) — file is created automatically
DATABASE_URL=sqlite:///./contextkeeper.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/contextkeeper

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
AUDIT_LOG_FILE=logs/audit.log

# ── AI Provider ──────────────────────────────────────────────────────────────
# Options: mock | gemini | anthropic | openai
# "mock" works fully offline — good for development/demo
AI_PROVIDER=mock

# Provider API keys — set the one matching AI_PROVIDER
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI behaviour (optional overrides)
# AI_MODEL=                # overrides provider default model
# AI_TEMPERATURE=0.2
# AI_TIMEOUT_SECONDS=60
# AI_MAX_RETRIES=3

# Simulate AI failures (mock provider only)
# MOCK_AI_FAIL=            # leave empty for normal; set to: timeout | rate_limit | upstream | json_error

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=change-this-admin-token

# ── SMTP (optional) ──────────────────────────────────────────────────────────
SMTP_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

